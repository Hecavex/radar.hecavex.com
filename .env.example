# HECAVEX maintainer and GitHub Actions configuration reference. This file is
# not loaded automatically and is not an end-user setup template.

# Public build metadata. The Pages workflow reads this repository variable;
# the value is a public site identifier rather than a credential.
HECAVEX_ANALYTICS_TOKEN=

# Shared collection/publication rollback. GitHub Actions reads this repository variable.
# Explicit false disables supplemental visual admissions; hostname mismatch preservation remains on.
HECAVEX_IDN_VISUAL_MATCHING=true

# Transient discovery seeds can trigger exact passive URLScan lookups. They are
# never published as dashboard records or source labels. Never commit keys.
URLSCAN_INTELLIGENCE_SEEDS_ENABLED=true
INTELLIGENCE_SEED_MIN_CONFIDENCE=80
INTELLIGENCE_SEED_LIMIT=250
PHISHDESTROY_SEED_ENABLED=true
CERTPL_SEED_ENABLED=true

# Recent daily CertStream candidate archives included by the Python sync command.
CERTSTREAM_ARCHIVE_ENABLED=true
RADAR_CT_LOOKBACK_DAYS=7

# CertStream collector. The default is the same eight-minute window used by GitHub.
CERTSTREAM_URL=
CERTSTREAM_ALLOW_INSECURE_WS=false
CERTSTREAM_DURATION_SECONDS=480
CERTSTREAM_FLUSH_SECONDS=15
CERTSTREAM_IDLE_SECONDS=90
CERTSTREAM_REQUIRE_MESSAGES=false
CERTSTREAM_MIN_CONFIDENCE=80
CERTSTREAM_ARCHIVE_ROOT=data/certstream
# Optional for maintainer diagnostics; the scheduled workflow always writes this public artifact.
CERTSTREAM_HEALTH_PATH=public/data/collection-health.json
CERTSTREAM_TRIGGER=manual
CERTSTREAM_SCHEDULE_MINUTES=8,23,38,53
CERTSTREAM_EXPECTED_INTERVAL_SECONDS=900
CERTSTREAM_DELAY_THRESHOLD_SECONDS=300
CERTSTREAM_STALE_AFTER_SECONDS=2700

# Passive URLScan search and result retrieval. Keep the key only in an operator
# process environment or GitHub Actions secret. The hunter never submits a scan
# or visits a candidate host. A missing key records an explicit successful skip.
URLSCAN_API_KEY=
# Keep false until URLScan has explicitly confirmed the intended derived-data
# redistribution. Authentication alone is not that permission.
URLSCAN_DERIVED_REDISTRIBUTION_CONFIRMED=false
URLSCAN_ARCHIVE_ENABLED=true
URLSCAN_ARCHIVE_ROOT=data/urlscan
URLSCAN_LOOKBACK_DAYS=7
URLSCAN_MIN_CONFIDENCE=80
URLSCAN_SEARCH_LIMIT=100
URLSCAN_DETAIL_LIMIT=30
URLSCAN_TITLE_DETAIL_LIMIT=10
URLSCAN_HASH_PIVOT_LIMIT=3
URLSCAN_HASH_RESULT_LIMIT=10
URLSCAN_HASH_DETAIL_LIMIT=30
URLSCAN_CT_SEEDS_ENABLED=true
URLSCAN_CT_ARCHIVE_ROOT=data/certstream
URLSCAN_CT_LOOKBACK_DAYS=7
URLSCAN_CT_SEED_LIMIT=100
URLSCAN_CT_SEED_MIN_CONFIDENCE=80
URLSCAN_RADAR_SEEDS_ENABLED=true
URLSCAN_RADAR_SNAPSHOT=public/data/radar.json
URLSCAN_RADAR_SEED_LIMIT=250
URLSCAN_EXACT_SEED_LIMIT=250
URLSCAN_SEED_BATCH_SIZE=20
URLSCAN_SEED_SEARCH_LIMIT=50
URLSCAN_SEED_DETAIL_LIMIT=30
URLSCAN_SEED_ROTATION_SHARDS=1
URLSCAN_SEEDS_PER_RUN=250
# Conservative local ledgers below URLScan's published quotas. Only successful
# API responses consume these counters; HTTP 429 ends the run safely.
URLSCAN_DAILY_SEARCH_CAP=900
URLSCAN_DAILY_RESULT_CAP=8000
URLSCAN_RUN_SEARCH_CAP=25
URLSCAN_RUN_RESULT_CAP=100
URLSCAN_MAX_SIGNALS=500
URLSCAN_ASSET_LOOKBACK_DAYS=30
URLSCAN_ASSET_OFFICIAL_DOMAINS_PER_RUN=20
URLSCAN_ASSET_OFFICIAL_BATCH_SIZE=1
URLSCAN_ASSET_OFFICIAL_SEARCH_LIMIT=100
URLSCAN_ASSET_OFFICIAL_DETAIL_LIMIT=40
URLSCAN_ASSET_HASHES_PER_RUN=12
URLSCAN_ASSET_HASH_RESULT_LIMIT=5
URLSCAN_ASSET_HASH_DETAIL_LIMIT=60
URLSCAN_ASSET_DAILY_SEARCH_CAP=80
URLSCAN_ASSET_DAILY_RESULT_CAP=400
URLSCAN_ASSET_RUN_SEARCH_CAP=40
URLSCAN_ASSET_RUN_RESULT_CAP=100
RADAR_URLSCAN_LOOKBACK_DAYS=30
RADAR_DETAIL_ROOT=public/data/signals

# Passive context for already-published candidates. The scheduled collector
# queries DNS-over-HTTPS and RDAP only; it never requests the candidate site.
DOMAIN_CONTEXT_PATH=data/enrichment/domain-context.json
DOMAIN_CONTEXT_PER_RUN=20
DOMAIN_CONTEXT_RETENTION_DAYS=14
DOMAIN_CONTEXT_RUN_BUDGET_SECONDS=600

# Bounded temporal change journal for already-published candidates. URLScan
# components remain excluded unless the redistribution variable above is true.
PASSIVE_CONTEXT_STATE=data/enrichment/passive-context.json
PASSIVE_CONTEXT_JOURNAL=data/history/context
PASSIVE_CONTEXT_PER_RUN=20
PASSIVE_CONTEXT_CACHE_HOURS=24
PASSIVE_CONTEXT_URLSCAN_DAYS=14
PASSIVE_CONTEXT_JOURNAL_DAYS=60
PASSIVE_CONTEXT_RPKI_ENABLED=false
PASSIVE_CONTEXT_RUN_BUDGET_SECONDS=480

# Bounded replayable Certificate Transparency keyword polling. This augments,
# but does not make complete, the sampled live CertStream observation windows.
CT_SEARCH_STATE_PATH=data/ct-search/state.json
CT_SEARCH_QUERIES_PER_RUN=6
CT_SEARCH_ROWS_PER_QUERY=500
CT_SEARCH_BOOTSTRAP_DAYS=7
CT_SEARCH_REPLAY_IDS=1000
CT_SEARCH_REPLAY_ROWS=50

# Optional machine-to-machine endpoint that returns the public export contract.
# Production requires HTTPS; HTTP loopback exists only for local maintainer validation.
HECAVEX_ENABLED=false
HECAVEX_FEED_URL=
HECAVEX_FEED_TOKEN=
# Optional operator-workstation, defanged candidate handoff to the private project.
HECAVEX_CANDIDATE_OUTPUT=data/hecavex/pivot-candidates.json

# Snapshot publication safeguards.
RADAR_MAX_SIGNALS=2500
RADAR_MIN_SIGNALS=0
RADAR_MIN_RETAINED_PERCENT=25
RADAR_SNAPSHOT_GUARD_DAYS=30
RADAR_RETAIN_EXISTING_SIGNALS=true
RADAR_RETAIN_DAYS=7
RADAR_ALLOW_SMALL_SNAPSHOT=false
RADAR_OUTPUT=public/data/radar.json
RADAR_STIX_OUTPUT=public/data/radar.stix.json
RADAR_REVIEWED_STIX_OUTPUT=public/data/radar-reviewed.stix.json

# Bounded, reproducible candidate history. Detailed daily events compact into
# a rolling summary after 30 days and age out after two years by default.
RADAR_HISTORY_ROOT=data/history
RADAR_HISTORY_OUTPUT=public/data/history.json
RADAR_HISTORY_DETAIL_DAYS=30
RADAR_HISTORY_SUMMARY_DAYS=730
RADAR_HISTORY_MAX_SIGNALS=5000

# Only this sanitized, reviewed export is read by automation. The private
# SQLite review ledger lives outside the repository (RADAR_REVIEW_DB).
RADAR_REVIEW_DECISIONS_PATH=data/review/public-decisions.json
RADAR_REVIEW_DB=
RADAR_MISP_FEED_ENABLED=false

# Optional provider context. VirusTotal may be configured as a GitHub Actions
# secret; the public workflow discards the response. Safe Browsing is strictly
# local-only because v5 requires private caching of match and no-match results.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# Fixed, git-ignored cache path used by the local provider-check command.
# .radar-local/provider-check-cache.json

# Weekly release publication must remain disabled until immutable releases are
# enabled in repository settings.
RADAR_IMMUTABLE_RELEASES_CONFIRMED=false
